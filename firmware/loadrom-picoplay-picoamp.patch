+// -----------------------------------------------------------------------
+// Case 21: Sunrise IDE (microSD) + 1MB mapper + TMTLogic SE-ONE emulation
+// -----------------------------------------------------------------------
+// Same expanded-slot layout as case 16 (Nextor on sub-slot 0, 1MB PSRAM
+// mapper on sub-slot 1) plus the SE-ONE MP3 cartridge on I/O ports
+// 0x20-0x27 (see seone/seone_bus.c), so SymbOS + "SE Play" can browse and
+// play MP3/WAV files and M3U playlists from the same microSD card through
+// the I2S DAC.
+//
+// Core 1 alternates between Nextor's raw sector requests and the SE-ONE
+// command / MP3 decoding work. The upper part of the 256KB SRAM ROM cache
+// (above the 128KB Nextor kernel) is handed to the SE-ONE as its arena.
+//
+// I/O reads are not stretched with /WAIT, so they are serviced between every
+// memory-write event: a PSRAM access that stalls on the shared QMI bus while
+// core 1 fetches code from flash must never delay an I/O reply.
+static void __no_inline_not_in_flash_func(core1_seone_task)(void)
+{
+    sunrise_sd_init();
+    seone_core1_init();
+    while (true)
+    {
+        sunrise_sd_poll();
+        seone_core1_poll();
+    }
+}
+
+static inline void __not_in_flash_func(seone_drain_io_writes)(uint8_t *mapper_reg)
+{
+    uint16_t io_addr;
+    uint8_t io_data;
+    while (pio_try_get_io_write(&io_addr, &io_data))
+    {
+        uint8_t port = io_addr & 0xFFu;
+        if (port >= 0xFCu)
+            mapper_reg[port - 0xFCu] = io_data & 0x3Fu;
+        else if (seone_port_claimed(port))
+            seone_io_write(port, io_data);
+    }
+}
+
+static inline void __not_in_flash_func(seone_service_io_reads)(uint8_t *mapper_reg)
+{
+    while (!pio_sm_is_rx_fifo_empty(msx_io_bus.pio_read, msx_io_bus.sm_io_read))
+    {
+        uint8_t port = (uint8_t)(pio_sm_get(msx_io_bus.pio_read, msx_io_bus.sm_io_read) & 0xFFu);
+        bool drive = false;
+        uint8_t data = 0xFFu;
+
+        if (port >= 0xFCu)
+        {
+            drive = true;
+            data = (uint8_t)(0xC0u | (mapper_reg[port - 0xFCu] & 0x3Fu));
+        }
+        else if (seone_port_claimed(port))
+        {
+            // An OUT that immediately precedes this IN may still sit in the
+            // write FIFO; apply it first so replies follow program order.
+            seone_drain_io_writes(mapper_reg);
+            drive = seone_io_read(port, &data);
+        }
+
+        pio_sm_put_blocking(msx_io_bus.pio_read, msx_io_bus.sm_io_read, pio_build_token(drive, data));
+    }
+}
+
+void __no_inline_not_in_flash_func(loadrom_sunrise_mapper_seone_sd)(uint32_t offset, bool cache_enable, bool wifi_enable)
+{
+    // Phase 1 — Bootstrap: minimal ROM that restarts the MSX (see case 11)
+    static const uint8_t bootstrap_rom[] = {
+        0x41, 0x42,            // 'AB' ROM header
+        0x0A, 0x40,            // INIT = 0x400A
+        0x00, 0x00,            // STATEMENT = none
+        0x00, 0x00,            // DEVICE = none
+        0x00, 0x00,            // TEXT = none
+        0xF3,                  // DI
+        0xDB, 0xF4,            // IN A, (0xF4)
+        0xF6, 0x80,            // OR 0x80
+        0xD3, 0xF4,            // OUT (0xF4), A
+        0xC7                   // RST 0x00
+    };
+
+    msx_pio_bus_init();
+
+    bool restart_detected = false;
+    bool init_called = false;
+
+    while (!restart_detected)
+    {
+        { uint16_t waddr; uint8_t wdata; while (pio_try_get_write(&waddr, &wdata)) { } }
+
+        if (!pio_sm_is_rx_fifo_empty(msx_bus.pio, msx_bus.sm_read))
+        {
+            uint16_t addr = (uint16_t)pio_sm_get(msx_bus.pio, msx_bus.sm_read);
+            if (init_called && addr == 0x0000u)
+            {
+                pio_sm_put_blocking(msx_bus.pio, msx_bus.sm_read, pio_build_token(false, 0xFFu));
+                restart_detected = true;
+            }
+            else
+            {
+                if (addr >= 0x400Au && addr <= 0x4011u) init_called = true;
+                bool in_window = (addr >= 0x4000u && addr <= 0x7FFFu);
+                uint8_t data = 0xFFu;
+                if (in_window)
+                {
+                    uint32_t rel = addr - 0x4000u;
+                    if (rel < sizeof(bootstrap_rom)) data = bootstrap_rom[rel];
+                }
+                pio_sm_put_blocking(msx_bus.pio, msx_bus.sm_read, pio_build_token(in_window, data));
+            }
+        }
+        else
+        {
+            if (init_called && !gpio_get(PIN_RD) && ((gpio_get_all() & 0xFFFFu) == 0x0000u))
+                restart_detected = true;
+        }
+    }
+
+    // Phase 2 — Initialise expanded-slot mapper with the MSX frozen
+    pio_sm_set_enabled(pio0, 0, false);
+    pio_sm_set_enabled(pio0, 1, false);
+    gpio_init(PIN_WAIT);
+    gpio_set_dir(PIN_WAIT, GPIO_OUT);
+    gpio_put(PIN_WAIT, 0);
+
+    const uint8_t *rom_base;
+    uint32_t available_length;
+    prepare_sunrise_mapper_rom_source(offset, cache_enable, &rom_base, &available_length);
+    const uint8_t *wifi_rom_base = rom + offset + available_length;
+
+    // Expanded-slot layout. Without WiFi: 0 = Nextor, 1 = mapper.
+    // With WiFi (-w), as in the other Sunrise WiFi modes: 0 = ESP8266P BIOS
+    // + memio UART at 0x7F05-0x7F07, 1 = Nextor, 2 = mapper.
+    const uint8_t ss_wifi   = wifi_enable ? 0u : 0xFFu;
+    const uint8_t ss_nextor = wifi_enable ? 1u : 0u;
+    const uint8_t ss_mapper = wifi_enable ? 2u : 1u;
+
+    // SE-ONE arena: the part of the SRAM ROM cache the Nextor kernel leaves free
+    uint32_t arena_start = (rom_cached_size + 7u) & ~7u;
+    if (arena_start > CACHE_SIZE - SEONE_ARENA_MIN_SIZE)
+    {
+        while (true) { tight_loop_contents(); }
+    }
+    seone_init(&rom_sram[arena_start], CACHE_SIZE - arena_start);
+
+    static sunrise_ide_t ide;
+    sunrise_ide_init(&ide);
+    sunrise_sd_set_ide_ctx(&ide);
+    multicore_launch_core1_with_stack(core1_seone_task, seone_core1_stack(), SEONE_CORE1_STACK_SIZE);
+    if (wifi_enable)
+        wifi_uart_init_once();
+
+    psram_mem_init();
+    if (!psram_alloc(MAPPER_SIZE, &mapper_region))
+    {
+        while (true) { tight_loop_contents(); }
+    }
+
+    uint8_t mapper_reg[4] = { 3, 2, 1, 0 };
+    uint8_t subslot_reg = (uint8_t)(ss_mapper << 4);   // page 2 -> mapper for MAP_INIT
+
+    mapper_fill_ff();
+
+    msx_pio_io_bus_init();
+    msx_pio_bus_init();
+
+    while (true)
+    {
+        if (wifi_enable)
+            wifi_service_rx();
+        seone_service_io_reads(mapper_reg);
+
+        // Memory writes: sub-slot register, Sunrise IDE, mapper RAM
+        {
+            uint16_t waddr; uint8_t wdata;
+            while (pio_try_get_write(&waddr, &wdata))
+            {
+                if (waddr == 0xFFFFu)
+                    subslot_reg = wdata;
+                else
+                {
+                    uint8_t page = (waddr >> 14) & 0x03u;
+                    uint8_t active_subslot = (subslot_reg >> (page * 2)) & 0x03u;
+                    if (active_subslot == ss_nextor)
+                    {
+                        if (waddr >= 0x4000u && waddr <= 0x7FFFu)
+                            sunrise_ide_handle_write(&ide, waddr, wdata);
+                    }
+                    else if (active_subslot == ss_wifi)
+                    {
+                        (void)wifi_handle_mem_write(waddr, wdata);
+                    }
+                    else if (active_subslot == ss_mapper)
+                    {
+                        uint8_t mapper_page = mapper_page_from_reg(mapper_reg[page]);
+                        uint32_t mapper_offset = ((uint32_t)mapper_page << 14) | (waddr & 0x3FFFu);
+                        mapper_write_byte(mapper_offset, wdata);
+                    }
+                }
+                seone_service_io_reads(mapper_reg);
+            }
+        }
+
+        seone_drain_io_writes(mapper_reg);
+        seone_service_io_reads(mapper_reg);
+
+        // Memory reads
+        if (!pio_sm_is_rx_fifo_empty(msx_bus.pio, msx_bus.sm_read))
+        {
+            uint16_t addr = (uint16_t)pio_sm_get(msx_bus.pio, msx_bus.sm_read);
+            uint8_t data = 0xFFu;
+            bool in_window = false;
+
+            if (addr == 0xFFFFu)
+            {
+                in_window = true;
+                data = ~subslot_reg;
+            }
+            else
+            {
+                uint8_t page = (addr >> 14) & 0x03u;
+                uint8_t active_subslot = (subslot_reg >> (page * 2)) & 0x03u;
+                if (active_subslot == ss_wifi)
+                {
+                    in_window = true;
+                    if (addr >= 0x4000u && addr <= 0x7FFFu)
+                        data = wifi_handle_mem_read(wifi_rom_base, addr);
+                }
+                else if (active_subslot == ss_nextor)
+                {
+                    if (addr >= 0x4000u && addr <= 0x7FFFu)
+                    {
+                        in_window = true;
+                        uint8_t ide_data;
+                        if (sunrise_ide_handle_read(&ide, addr, &ide_data))
+                            data = ide_data;
+                        else
+                        {
+                            uint8_t seg = ide.segment;
+                            uint32_t rel = ((uint32_t)seg << 14) + (addr & 0x3FFFu);
+                            if (available_length == 0u || rel < available_length)
+                                data = read_rom_byte(rom_base, rel);
+                        }
+                    }
+                }
+                else if (active_subslot == ss_mapper)
+                {
+                    in_window = true;
+                    uint8_t mapper_page = mapper_page_from_reg(mapper_reg[page]);
+                    uint32_t mapper_offset = ((uint32_t)mapper_page << 14) | (addr & 0x3FFFu);
+                    data = mapper_read_byte(mapper_offset);
+                }
+            }
+
+            pio_sm_put_blocking(msx_bus.pio, msx_bus.sm_read, pio_build_token(in_window, data));
+        }
+    }
+}
+
+// -----------------------------------------------------------------------
+// Nextor (Sunrise IDE, microSD) + 1MB mapper + optional WiFi + PicoVerse
+// Audio Engine (ROM type 22, loadrom -a1 [-w]).
+//
+// The slot layout is the one of the hardware-confirmed SymbOS setup
+// (-m1 -w), so SymbOS drive settings do not change:
+//   sub-slot 0 = ESP8266 BIOS + memio UART (with -w, else empty)
+//   sub-slot 1 = Nextor + Sunrise IDE
+//   sub-slot 2 = 1 MB mapper RAM
+//   sub-slot 3 = PicoVerse Audio Engine register window (4000h-4FFFh)
+// The engine is reached with memory cycles only, so /WAIT protects every
+// access. Core 1 runs the microSD card (Nextor and the engine share it) and
+// the engine; it sleeps briefly whenever there is nothing to do, to leave
+// the shared buses to the core 0 bus loop.
+// -----------------------------------------------------------------------
+#define PVA_CORE1_STACK_SIZE (8u * 1024u)
+static uint32_t *pva_core1_stack;
+
+// The engine starts only when the MSX sends it its first command (PVTEST,
+// PicoPlay). Until then core 1 serves only the microSD card for Nextor, so
+// booting never depends on the player code.
+static void __no_inline_not_in_flash_func(core1_pva_task)(void)
+{
+    sunrise_sd_init();
+    while (!pva_command_pending())
+    {
+        sunrise_sd_poll();
+        sleep_us(50);
+    }
+    pva_core1_init();
+    while (true)
+    {
+        if (pva_win) pva_win[PVA_R_WHERE] = PVA_W_CARD;
+        sunrise_sd_poll();
+        if (!pva_core1_poll())
+            sleep_us(50);
+    }
+}
+
+void __no_inline_not_in_flash_func(loadrom_sunrise_mapper_pva_sd)(uint32_t offset, bool cache_enable, bool wifi_enable)
+{
+    sunrise_wait_for_expanded_bootstrap();
+
+    pio_sm_set_enabled(pio0, 0, false);
+    pio_sm_set_enabled(pio0, 1, false);
+    gpio_init(PIN_WAIT);
+    gpio_set_dir(PIN_WAIT, GPIO_OUT);
+    gpio_put(PIN_WAIT, 0);
+
+    const uint8_t *rom_base;
+    uint32_t available_length;
+    prepare_sunrise_mapper_rom_source(offset, cache_enable, &rom_base, &available_length);
+    const uint8_t *wifi_rom_base = rom + offset + available_length;
+
+    // Engine arena: the part of the SRAM ROM cache the Nextor kernel leaves free
+    uint32_t arena_start = (rom_cached_size + 7u) & ~7u;
+    if (arena_start + PVA_CORE1_STACK_SIZE + PVA_ARENA_MIN_SIZE > CACHE_SIZE)
+    {
+        while (true) { tight_loop_contents(); }
+    }
+    pva_core1_stack = (uint32_t *)&rom_sram[arena_start];
+    memset(pva_core1_stack, 0xA5, PVA_CORE1_STACK_SIZE);
+    arena_start += PVA_CORE1_STACK_SIZE;
+    pva_init(&rom_sram[arena_start], CACHE_SIZE - arena_start);
+    pva_set_stack((const uint8_t *)pva_core1_stack, PVA_CORE1_STACK_SIZE);
+
+    static sunrise_ide_t ide;
+    sunrise_ide_init(&ide);
+    sunrise_sd_set_ide_ctx(&ide);
+    wifi_link_present = wifi_enable;
+    if (wifi_enable)
+        wifi_uart_init_once();
+    multicore_launch_core1_with_stack(core1_pva_task, pva_core1_stack, PVA_CORE1_STACK_SIZE);
+
+    uint8_t mapper_reg[4] = { 3, 2, 1, 0 };
+    uint8_t subslot_reg = 0x20u;                 // page 2 -> mapper for the boot RAM probe
+
+    psram_mem_init();
+    if (!psram_alloc(MAPPER_SIZE, &mapper_region))
+    {
+        while (true) { tight_loop_contents(); }
+    }
+    mapper_fill_ff();
+    msx_pio_io_bus_init();
+    msx_pio_bus_init();
+
+    // Memory and I/O writes. They are also drained right before a read is
+    // answered: a write the Z80 made just before (the sub-slot register at
+    // FFFFh, a mapper port, a byte of RAM it reads back) must land first, or
+    // the read sees the old state (a wrong sub-slot, segment or byte), which
+    // crashed MSX-DOS programs that switch slots often.
+#define PVA_DRAIN_WRITES()                                                              \
+    do {                                                                                \
+        uint16_t waddr;                                                                 \
+        uint8_t wdata;                                                                  \
+        while (pio_try_get_write(&waddr, &wdata))                                       \
+        {                                                                               \
+            if (waddr == 0xFFFFu)                                                       \
+            {                                                                           \
+                subslot_reg = wdata;                                                    \
+                continue;                                                               \
+            }                                                                           \
+            uint8_t wpage = (waddr >> 14) & 0x03u;                                      \
+            uint8_t wsub = (subslot_reg >> (wpage * 2)) & 0x03u;                        \
+            if (wsub == 0)                                                              \
+            {                                                                           \
+                if (wifi_enable)                                                        \
+                    (void)wifi_handle_mem_write(waddr, wdata);                          \
+            }                                                                           \
+            else if (wsub == 1)                                                         \
+            {                                                                           \
+                if (waddr >= 0x4000u && waddr <= 0x7FFFu)                               \
+                    sunrise_ide_handle_write(&ide, waddr, wdata);                       \
+            }                                                                           \
+            else if (wsub == 2)                                                         \
+            {                                                                           \
+                uint8_t mapper_page = mapper_page_from_reg(mapper_reg[wpage]);          \
+                uint32_t mapper_offset = ((uint32_t)mapper_page << 14) | (waddr & 0x3FFFu); \
+                mapper_write_byte(mapper_offset, wdata);                                \
+            }                                                                           \
+            else if (wpage == 1)                                                        \
+            {                                                                           \
+                pva_mem_write(waddr, wdata);                                            \
+            }                                                                           \
+        }                                                                               \
+        uint16_t iwaddr;                                                                \
+        uint8_t iwdata;                                                                 \
+        while (pio_try_get_io_write(&iwaddr, &iwdata))                                  \
+        {                                                                               \
+            uint8_t port = iwaddr & 0xFFu;                                              \
+            if (port >= 0xFCu)                                                          \
+                mapper_reg[port - 0xFCu] = iwdata & 0x3Fu;                              \
+        }                                                                               \
+    } while (0)
+
+    while (true)
+    {
+        if (wifi_enable)
+            wifi_service_rx();
+
+        PVA_DRAIN_WRITES();
+
+        {
+            uint16_t io_addr;
+            while (pio_try_get_io_read(&io_addr))
+            {
+                PVA_DRAIN_WRITES();
+                uint8_t port = io_addr & 0xFFu;
+                bool in_window = false;
+                uint8_t data = 0xFFu;
+                if (port >= 0xFCu)
+                {
+                    in_window = true;
+                    data = (uint8_t)(0xC0u | (mapper_reg[port - 0xFCu] & 0x3Fu));
+                }
+                pio_sm_put_blocking(msx_io_bus.pio_read, msx_io_bus.sm_io_read, pio_build_token(in_window, data));
+            }
+        }
+
+        if (!pio_sm_is_rx_fifo_empty(msx_bus.pio, msx_bus.sm_read))
+        {
+            uint16_t addr = (uint16_t)pio_sm_get(msx_bus.pio, msx_bus.sm_read);
+            PVA_DRAIN_WRITES();                 // whatever the Z80 wrote before this read
+            uint8_t data = 0xFFu;
+            bool in_window = true;              // always drive the bus when our slot is selected
+
+            if (addr == 0xFFFFu)
+            {
+                data = (uint8_t)~subslot_reg;
+            }
+            else
+            {
+                uint8_t page = (addr >> 14) & 0x03u;
+                uint8_t active_subslot = (subslot_reg >> (page * 2)) & 0x03u;
+                if (active_subslot == 0)
+                {
+                    if (wifi_enable && page == 1)
+                        data = wifi_handle_mem_read(wifi_rom_base, addr);
+                }
+                else if (active_subslot == 1)
+                {
+                    if (page == 1)
+                    {
+                        uint8_t ide_data;
+                        if (sunrise_ide_handle_read(&ide, addr, &ide_data))
+                            data = ide_data;
+                        else
+                        {
+                            uint8_t seg = ide.segment;
+                            uint32_t rel = ((uint32_t)seg << 14) + (addr & 0x3FFFu);
+                            if (available_length == 0u || rel < available_length)
+                                data = read_rom_byte(rom_base, rel);
+                        }
+                    }
+                }
+                else if (active_subslot == 2)
+                {
+                    uint8_t mapper_page = mapper_page_from_reg(mapper_reg[page]);
+                    uint32_t mapper_offset = ((uint32_t)mapper_page << 14) | (addr & 0x3FFFu);
+                    data = mapper_read_byte(mapper_offset);
+                }
+                else if (page == 1)
+                {
+                    data = pva_mem_read(addr);
+                }
+            }
+            pio_sm_put_blocking(msx_bus.pio, msx_bus.sm_read, pio_build_token(in_window, data));
+        }
+    }
+#undef PVA_DRAIN_WRITES
+}
+
+// -----------------------------------------------------------------------
+// PicoAmp ROM (ROM type 23, loadrom -pa [-w]): the PICOAMP player as a 16 KB
+// cartridge ROM plus the PicoVerse Audio Engine, without Nextor or a mapper.
+// The MSX boots straight into the player; the engine reads the microSD card
+// itself and uses the ESP-01 for internet radio.
+//   sub-slot 0 = PICOAMP.ROM (4000h-7FFFh; its INIT copies it to RAM)
+//   sub-slot 3 = PicoVerse Audio Engine register window (4000h-4FFFh)
+// -----------------------------------------------------------------------
+void __no_inline_not_in_flash_func(loadrom_picoamp)(uint32_t offset, bool wifi_enable)
+{
+    sunrise_wait_for_expanded_bootstrap();
+
+    pio_sm_set_enabled(pio0, 0, false);
+    pio_sm_set_enabled(pio0, 1, false);
+    gpio_init(PIN_WAIT);
+    gpio_set_dir(PIN_WAIT, GPIO_OUT);
+    gpio_put(PIN_WAIT, 0);
+
+    const uint8_t *rom_base;
+    uint32_t available_length;
+    prepare_sunrise_mapper_rom_source(offset, true, &rom_base, &available_length);
+
+    // the engine's arena: the SRAM cache after the ROM (16 KB banks: PICOAMP and its pages)
+    uint32_t arena_start = (rom_cached_size + 7u) & ~7u;
+    if (arena_start + PVA_CORE1_STACK_SIZE + PVA_ARENA_MIN_SIZE > CACHE_SIZE)
+    {
+        while (true) { tight_loop_contents(); }
+    }
+    pva_core1_stack = (uint32_t *)&rom_sram[arena_start];
+    memset(pva_core1_stack, 0xA5, PVA_CORE1_STACK_SIZE);
+    arena_start += PVA_CORE1_STACK_SIZE;
+    pva_init(&rom_sram[arena_start], CACHE_SIZE - arena_start);
+    pva_set_stack((const uint8_t *)pva_core1_stack, PVA_CORE1_STACK_SIZE);
+    pva_allow_card_writes(true);           // no Nextor: the engine may write RADIOFAV.M3U
+
+    // the card driver as in the Nextor modes (core 1 polls it); no IDE on the bus
+    static sunrise_ide_t ide;
+    sunrise_ide_init(&ide);
+    sunrise_sd_set_ide_ctx(&ide);
+    wifi_link_present = wifi_enable;
+    if (wifi_enable)
+        wifi_uart_init_once();             // the UART IRQ hands the engine its bytes
+    multicore_launch_core1_with_stack(core1_pva_task, pva_core1_stack, PVA_CORE1_STACK_SIZE);
+
+    uint8_t subslot_reg = 0x00u;
+    uint8_t rom_bank = 0u;                  // the 16 KB bank of the ROM in page 1 (6000h-67FFh, as ASCII16)
+    msx_pio_bus_init();
+
+    // writes are applied before every read (see loadrom_sunrise_mapper_pva_sd)
+#define PA_DRAIN_WRITES()                                                       \
+    do {                                                                        \
+        uint16_t waddr;                                                         \
+        uint8_t wdata;                                                          \
+        while (pio_try_get_write(&waddr, &wdata))                               \
+        {                                                                       \
+            if (waddr == 0xFFFFu)                                               \
+                subslot_reg = wdata;                                            \
+            else if (((waddr >> 14) & 3u) == 1u && ((subslot_reg >> 2) & 3u) == 3u) \
+                pva_mem_write(waddr, wdata);                                    \
+            else if ((waddr & 0xF800u) == 0x6000u && ((subslot_reg >> 2) & 3u) == 0u) \
+                rom_bank = wdata & 3u;                                          \
+        }                                                                       \
+    } while (0)
+
+    while (true)
+    {
+        PA_DRAIN_WRITES();
+        if (!pio_sm_is_rx_fifo_empty(msx_bus.pio, msx_bus.sm_read))
+        {
+            uint16_t addr = (uint16_t)pio_sm_get(msx_bus.pio, msx_bus.sm_read);
+            PA_DRAIN_WRITES();
+            uint8_t data = 0xFFu;
+            if (addr == 0xFFFFu)
+                data = (uint8_t)~subslot_reg;
+            else if (((addr >> 14) & 3u) == 1u)
+            {
+                uint8_t sub = (subslot_reg >> 2) & 3u;
+                if (sub == 0u)
+                {
+                    uint32_t rel = ((uint32_t)rom_bank << 14) | (addr & 0x3FFFu);
+                    if (rel < available_length)
+                        data = read_rom_byte(rom_base, rel);
+                }
+                else if (sub == 3u)
+                    data = pva_mem_read(addr);
+            }
+            // an expanded slot: every read in it is answered (FFh where nothing is)
+            pio_sm_put_blocking(msx_bus.pio, msx_bus.sm_read, pio_build_token(true, data));
+        }
+    }
+#undef PA_DRAIN_WRITES
+}
+
 void __no_inline_not_in_flash_func(loadrom_neo8)(uint32_t offset)
 {
     uint16_t bank_registers[6] = {0};
@@ -4729,7 +5392,8 @@ int __no_inline_not_in_flash_func(main)()
 
