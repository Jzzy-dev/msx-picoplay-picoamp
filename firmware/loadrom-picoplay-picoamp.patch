+++ b/2350/software/loadrom.pio/pico/loadrom/seone/tests/Makefile
@@ -0,0 +1,56 @@
+# Host test for the SE-ONE emulation.
+#   make FATFS=<no-OS-FatFS-SD-SDIO-SPI-RPi-Pico>/src MP3=<picomp3lib>/src USB_FILES=<SE-ONE USB_FILES dir> run
+.DEFAULT_GOAL := host_seplay
+FATFS     ?= ../../lib/no-OS-FatFS-SD-SDIO-SPI-RPi-Pico/src
+MP3       ?= ../../lib/picomp3lib/src
+USB_FILES ?= USB_FILES
+
+CFLAGS = -O2 -g -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare -DSEONE_HOST_TEST \
+         -I.. -Ihostinc -I$(FATFS)/include -I$(FATFS)/ff15/source -I$(MP3)
+
+SEONE  = ../seone_bus.c ../seone_cmd.c ../seone_audio.c
+FATSRC = $(FATFS)/ff15/source/ff.c $(FATFS)/ff15/source/ffunicode.c $(FATFS)/ff15/source/ffsystem.c
+MP3SRC = $(filter-out $(MP3)/buffers.c,$(wildcard $(MP3)/*.c))
+
+# same FatFS configuration as the firmware, plus f_chmod() for building the test image
+hostinc/ffconf.h: $(FATFS)/include/ffconf.h
+	mkdir -p hostinc
+	sed 's/^#define FF_USE_CHMOD.*/#define FF_USE_CHMOD 1/' $< > $@
+
+host_seplay: hostinc/ffconf.h host_seplay.c host_platform.c buffers.o $(SEONE)
+	$(CC) $(CFLAGS) -o $@ host_seplay.c host_platform.c buffers.o $(SEONE) \
+	    $(FATSRC) $(MP3SRC) -w -lm
+
+buffers.o: $(MP3)/buffers.c hostinc/ffconf.h
+	$(CC) $(CFLAGS) -w -DMPDEC_ALLOCATOR=seone_mp3_alloc -include ../seone_mp3_alloc.h -c $< -o $@
+
+run: host_seplay
+	./host_seplay $(USB_FILES)
+
+clean:
+	rm -rf host_seplay z80_seplay z80_netd buffers.o test.img out.wav hostinc
+
+# Optional: execute SE Play's own Z80 code against the emulation.
+#   make Z80DIR=<superzazu/z80 checkout> SEPLAY=<path to SEPLAY.EXE> z80
+Z80DIR ?= z80
+SEPLAY ?= SEPLAY.EXE
+z80_seplay: z80_seplay.c host_platform.c buffers.o $(SEONE) hostinc/ffconf.h
+	$(CC) $(CFLAGS) -I$(Z80DIR) -o $@ z80_seplay.c $(Z80DIR)/z80.c host_platform.c buffers.o $(SEONE) \
+	    $(FATSRC) $(MP3SRC) -w -lm
+
+z80: host_seplay z80_seplay
+	./host_seplay $(USB_FILES)
+	./z80_seplay $(SEPLAY) test.img
+
+# Optional: SE Play patched for the SymbOS Network Daemon (2350/software/symbos/seplay-netd)
+# run against a simulated SymbOS kernel + network daemon serving STREAM as web radio.
+#   make Z80DIR=<superzazu/z80> SEPLAY_NETD=<SEPLAYN.EXE> STREAM=<file.mp3> netd
+SEPLAY_NETD ?= SEPLAYN.EXE
+STREAM      ?= $(USB_FILES)/AUDIO/test.mp3
+z80_netd: z80_netd.c host_platform.c buffers.o $(SEONE) hostinc/ffconf.h
+	$(CC) $(CFLAGS) -I$(Z80DIR) -o $@ z80_netd.c $(Z80DIR)/z80.c host_platform.c buffers.o $(SEONE) \
+	    $(FATSRC) $(MP3SRC) -w -lm
+
+netd: host_seplay z80_netd
+	./host_seplay $(USB_FILES)
+	./z80_netd $(SEPLAY_NETD) test.img $(STREAM)
diff --git a/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_platform.c b/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_platform.c
new file mode 100644
index 0000000..4a5b999
--- /dev/null
+++ b/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_platform.c
@@ -0,0 +1,123 @@
+// Host test platform for the SE-ONE emulation: FatFS disk I/O over an image
+// file, a WAV-writing audio HAL and a millisecond clock.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "ff.h"
+#include "diskio.h"
+#include "../seone_internal.h"
+
+// ---------------- disk image ----------------
+static FILE    *img;
+static uint32_t img_sectors;
+uint32_t host_disk_reads;
+
+int host_disk_open(const char *path, uint32_t create_sectors)
+{
+    img = fopen(path, create_sectors ? "w+b" : "r+b");
+    if (!img) return -1;
+    if (create_sectors)
+    {
+        img_sectors = create_sectors;
+        fseek(img, (long)create_sectors * 512 - 1, SEEK_SET);
+        fputc(0, img);
+        fflush(img);
+    }
+    else
+    {
+        fseek(img, 0, SEEK_END);
+        img_sectors = (uint32_t)(ftell(img) / 512);
+    }
+    return 0;
+}
+
+DSTATUS disk_initialize(BYTE pdrv) { return (pdrv == 0 && img) ? 0 : STA_NOINIT; }
+DSTATUS disk_status(BYTE pdrv)     { return (pdrv == 0 && img) ? 0 : STA_NOINIT; }
+
+DRESULT disk_read(BYTE pdrv, BYTE *buff, LBA_t sector, UINT count)
+{
+    if (pdrv || !img || sector + count > img_sectors) return RES_PARERR;
+    host_disk_reads += count;
+    fseek(img, (long)sector * 512, SEEK_SET);
+    return fread(buff, 512, count, img) == count ? RES_OK : RES_ERROR;
+}
+
+DRESULT disk_write(BYTE pdrv, const BYTE *buff, LBA_t sector, UINT count)
+{
+    if (pdrv || !img || sector + count > img_sectors) return RES_PARERR;
+    fseek(img, (long)sector * 512, SEEK_SET);
+    return fwrite(buff, 512, count, img) == count ? RES_OK : RES_ERROR;
+}
+
+DRESULT disk_ioctl(BYTE pdrv, BYTE cmd, void *buff)
+{
+    if (pdrv || !img) return RES_PARERR;
+    switch (cmd)
+    {
+        case CTRL_SYNC:        fflush(img); return RES_OK;
+        case GET_SECTOR_COUNT: *(LBA_t *)buff = img_sectors; return RES_OK;
+        case GET_SECTOR_SIZE:  *(WORD *)buff = 512; return RES_OK;
+        case GET_BLOCK_SIZE:   *(DWORD *)buff = 1; return RES_OK;
+        default:               return RES_OK;
+    }
+}
+
+DWORD get_fattime(void) { return ((DWORD)(2026 - 1980) << 25) | (10u << 21) | (21u << 16); }
+
+// ---------------- audio HAL ----------------
+static int16_t  hal_buf[1152 * 2];
+static FILE    *wav;
+static uint32_t wav_frames, wav_rate;
+uint32_t host_audio_frames;
+uint32_t host_audio_last_rate;
+bool     host_audio_queue_full;     // simulate a full I2S queue
+
+void host_wav_open(const char *path)
+{
+    wav = fopen(path, "wb");
+    static const uint8_t hdr[44] = { 0 };
+    fwrite(hdr, 1, 44, wav);
+    wav_frames = 0;
+}
+
+void host_wav_close(void)
+{
+    if (!wav) return;
+    uint32_t data = wav_frames * 4, riff = data + 36, fmt_sz = 16, rate = wav_rate ? wav_rate : 44100;
+    uint16_t pcm = 1, ch = 2, bits = 16, align = 4;
+    uint32_t brate = rate * 4;
+    fseek(wav, 0, SEEK_SET);
+    fwrite("RIFF", 1, 4, wav); fwrite(&riff, 4, 1, wav); fwrite("WAVEfmt ", 1, 8, wav);
+    fwrite(&fmt_sz, 4, 1, wav); fwrite(&pcm, 2, 1, wav); fwrite(&ch, 2, 1, wav);
+    fwrite(&rate, 4, 1, wav); fwrite(&brate, 4, 1, wav); fwrite(&align, 2, 1, wav);
+    fwrite(&bits, 2, 1, wav); fwrite("data", 1, 4, wav); fwrite(&data, 4, 1, wav);
+    fclose(wav);
+    wav = NULL;
+}
+
+bool seone_hal_audio_init(void) { return true; }
+
+int16_t *seone_hal_audio_acquire(uint32_t *max_frames)
+{
+    if (host_audio_queue_full) return NULL;
+    *max_frames = 1152;
+    return hal_buf;
+}
+
+void seone_hal_audio_commit(uint32_t frames, uint32_t sample_rate)
+{
+    host_audio_frames += frames;
+    host_audio_last_rate = sample_rate;
+    if (wav)
+    {
+        fwrite(hal_buf, 4, frames, wav);
+        wav_frames += frames;
+        wav_rate = sample_rate;
+    }
+}
+
+static uint32_t fake_ms;
+uint32_t seone_hal_millis(void) { return fake_ms; }
+void host_advance_ms(uint32_t ms) { fake_ms += ms; }
diff --git a/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_seplay.c b/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_seplay.c
new file mode 100644
index 0000000..3a33702
--- /dev/null
+++ b/2350/software/loadrom.pio/pico/loadrom/seone/tests/host_seplay.c
@@ -0,0 +1,483 @@
+// Host test for the SE-ONE emulation.
+//
+// Builds a FAT16 image with FatFS, then drives the emulated ports exactly the
+// way SE Play 0.1 (SEPLAY.EXE, SymbOS) does, as reconstructed from its Z80
+// code: ATSEND/ATRECV (0x5A2D/0x5A98), the two-pass MSDFILES reader (0x1E5E),
+// M3U row handling (0x2568, 0x274A), status polling (0x103B) and the TNC
+// network-card probe (0x4FEC). Core 1 is simulated by calling
+// seone_core1_poll() only every few port polls.
+//
+// usage: host_seplay <dir with SE-ONE USB_FILES>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include "ff.h"
+#include "../seone.h"
+#include "../seone_internal.h"
+
+int  host_disk_open(const char *path, uint32_t create_sectors);
+void host_wav_open(const char *path);
+void host_wav_close(void);
+void host_advance_ms(uint32_t ms);
+extern uint32_t host_audio_frames, host_audio_last_rate, host_disk_reads;
+extern bool host_audio_queue_full;
+
+static int failures, checks;
+#define CHECK(cond, ...) do { checks++; if (!(cond)) { failures++; printf("  FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+// ------------------------------------------------------------------ ports
+static unsigned poll_counter;
+static void core1_tick(void) { seone_core1_poll(); host_advance_ms(1); }
+
+static uint8_t inp(uint8_t port)
+{
+    if (++poll_counter % 7u == 0u) core1_tick();     // core 1 runs concurrently
+    uint8_t v = 0xFF;
+    if (seone_port_claimed(port) && !seone_io_read(port, &v)) v = 0xFF;
+    return v;
+}
+
+static void outp(uint8_t port, uint8_t v)
+{
+    if (seone_port_claimed(port)) seone_io_write(port, v);
+}
+
+// ------------------------------------------------------------------ SE Play ATSEND / ATRECV
+static char RESP[64], RVAL[64];
+
+static int atsend(const char *fmt, ...)
+{
+    char cmd[400];
+    va_list ap; va_start(ap, fmt); vsnprintf(cmd, sizeof cmd, fmt, ap); va_end(ap);
+    for (const char *c = cmd; *c; c++)
+        if (*c != ' ') outp(0x20, (uint8_t)*c);           // spaces are never sent
+    outp(0x20, 13);
+
+    int i = 0, flag = 0, done = 0, cnt = 0, ri = 0, vi = 0;
+    while (!done)
+    {
+        int d = inp(0x20);
+        if (d > 31 && i < 50)
+        {
+            RESP[ri++] = (char)d;
+            if (flag) RVAL[vi++] = (char)d;
+            if (d == '=') flag = 1;
+            i++;
+        }
+        if (d == 13 || d == 10) done = 1;
+        if (i > 50) done = 2;
+        if (cnt > 5000) done = 2;
+        cnt++;
+    }
+    RESP[ri] = 0; RVAL[vi] = 0;
+    if (done == 2) strcpy(RESP, "AT+ERR");
+    return done;
+}
+
+// ------------------------------------------------------------------ SE Play file list (two passes)
+static char LIST[64][64];
+static int  LIST_N;
+
+static void rtrim(char *s) { size_t l = strlen(s); while (l && (unsigned char)s[l - 1] <= 32) s[--l] = 0; }
+
+static void read_pass(int want_dirs, int m3u_mode)
+{
+    char t[300]; int tl = 0;
+    int guard = 0;
+    int d = inp(0x25);
+    while (d != 0 && guard++ < 20000)
+    {
+        if (d == 9 && LIST_N < 49)
+        {
+            t[tl] = 0; rtrim(t);
+            int is_dir = t[0] == '/';
+            size_t l = strlen(t);
+            int is_m3u = l >= 4 && strcmp(t + l - 4, ".M3U") == 0;
+            int take = want_dirs ? is_dir : (!is_dir && (m3u_mode ? is_m3u : !is_m3u));
+            if (take) strcpy(LIST[LIST_N++], t);
+            tl = 0;
+        }
+        else if (tl < 299) t[tl++] = (char)d;
+        d = inp(0x25);
+    }
+}
+
+static void list_dir(int m3u_mode)
+{
+    LIST_N = 0;
+    atsend("AT+MSDFILES");
+    read_pass(1, m3u_mode);
+    atsend("AT+MSDFILES");
+    read_pass(0, m3u_mode);
+    strcpy(LIST[LIST_N], "_END_");
+}
+
+static int list_has(const char *name)
+{
+    for (int i = 0; i < LIST_N; i++) if (strcmp(LIST[i], name) == 0) return 1;
+    return 0;
+}
+
+static void list_print(void)
+{
+    printf("    list:");
+    for (int i = 0; i < LIST_N; i++) printf(" [%s]", LIST[i]);
+    printf("\n");
+}
+
+// SE Play's own short-name guess for an M3U row (0x274A)
+static void derive(const char *row, char *out)
+{
+    size_t len = strlen(row);
+    if (len <= 10) { strcpy(out, row); return; }
+    char t[8]; int n = 0;
+    for (size_t i = 0; i < len && i < 20 && n < 6; i++) if (row[i] != ' ') t[n++] = row[i];
+    t[n] = 0;
+    sprintf(out, "%s~1%s", t, row + len - 4);
+}
+
+static uint8_t status(void) { return inp(0x23); }
+
+static uint32_t run_until_end(uint32_t max_ticks)
+{
+    uint32_t t = 0;
+    while (!(status() & SEONE_ST_END_OF_MUSIC) && t < max_ticks) { core1_tick(); t++; }
+    return t;
+}
+
+// ------------------------------------------------------------------ image
+static uint8_t *slurp(const char *path, size_t *len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) { printf("missing %s\n", path); exit(2); }
+    fseek(f, 0, SEEK_END); *len = (size_t)ftell(f); fseek(f, 0, SEEK_SET);
+    uint8_t *b = malloc(*len); fread(b, 1, *len, f); fclose(f);
+    return b;
+}
+
+static void put(const char *dst, const void *data, size_t len)
+{
+    FIL f; UINT bw;
+    FRESULT fr = f_open(&f, dst, FA_CREATE_ALWAYS | FA_WRITE);
+    if (fr) { printf("f_open %s: %d\n", dst, fr); exit(2); }
+    f_write(&f, data, (UINT)len, &bw);
+    f_close(&f);
+}
+
+static void put_file(const char *dst, const char *src_dir, const char *src)
+{
+    char p[512]; size_t len;
+    snprintf(p, sizeof p, "%s/%s", src_dir, src);
+    uint8_t *b = slurp(p, &len);
+    put(dst, b, len);
+    free(b);
+}
+
+static void build_image(const char *files)
+{
+    static FATFS fs;
+    static BYTE work[4096];
+    host_disk_open("test.img", 128 * 2048);               // 128 MB
+    MKFS_PARM opt = { FM_FAT, 0, 0, 0, 0 };                // FAT16, as Nextor needs
+    if (f_mkfs("0:", &opt, work, sizeof work)) { printf("mkfs failed\n"); exit(2); }
+    f_mount(&fs, "0:", 1);
+
+    f_mkdir("0:/MUSIC");
+    f_mkdir("0:/MUSIC/Sandra Collection");
+    f_mkdir("0:/MUSIC/Sandra Collection/bonus");
+    f_mkdir("0:/SAMPLE");
+    f_mkdir("0:/SETALK");
+    f_mkdir("0:/System Volume Information");
+    f_chmod("0:/System Volume Information", AM_HID | AM_SYS, AM_HID | AM_SYS);
+
+    put_file("0:/MUSIC/Sandra Collection/01 Sandra - Maria Magdalena.mp3", files, "AUDIO/test.mp3");
+    put_file("0:/MUSIC/Sandra Collection/02 Sandra - In The Heat Of The Night.mp3", files, "AUDIO/SE_CPC.MP3");
+    put_file("0:/MUSIC/Sandra Collection/bonus/03 Bonus track number three.mp3", files, "AUDIO/test.mp3");
+    put_file("0:/MUSIC/Sandra Collection/04 A very long title that goes on and on and on forever.mp3", files, "AUDIO/test.mp3");
+    put_file("0:/MUSIC/short.mp3", files, "AUDIO/test.mp3");
+    put_file("0:/MUSIC/test.wav", files, "AUDIO/test.wav");
+    put_file("0:/MUSIC/readme.txt", files, "SAMPLE/readme.txt");
+    put_file("0:/MUSIC/._short.mp3", files, "SAMPLE/readme.txt");
+    put_file("0:/ROOT.MP3", files, "AUDIO/SE_CPC.MP3");
+    put_file("0:/SAMPLE/BELL.MP3", files, "SAMPLE/BELL.MP3");
+    put_file("0:/SETALK/SP02CH.MP3", files, "SETALK/SP02CH.MP3");
+    put_file("0:/SETALK/SP000H.mp3", files, "SETALK/SP000H.mp3");
+
+    const char *m3u =
+        "\xEF\xBB\xBF#EXTM3U\r\n"
+        "#EXTINF:238,01 Sandra - Maria Magdalena\r\n"
+        "01 Sandra - Maria Magdalena.mp3\r\n"
+        "\r\n"
+        "#EXTINF:239,02 Sandra - In The Heat Of The Night\r\n"
+        "C:\\Users\\me\\Music\\Sandra\\02 Sandra - In The Heat Of The Night.mp3\r\n"
+        "#EXTINF:100,03 Bonus\r\n"
+        "bonus/03 Bonus track number three.mp3\r\n"
+        "#EXTINF:100,04 Long\r\n"
+        "04 A very long title that goes on and on and on forever.mp3\r\n";
+    put("0:/MUSIC/Sandra Collection/Sandra.m3u", m3u, strlen(m3u));
+
+    // a big playlist: 1000 entries, only the last one exists
+    static char big[200000];
+    size_t bl = 0;
+    bl += sprintf(big + bl, "#EXTM3U\r\n");
+    for (int i = 1; i < 1000; i++)
+        bl += sprintf(big + bl, "#EXTINF:100,Artist %04d - Some Title\r\nMissing Artist %04d - Some Title.mp3\r\n", i, i);
+    bl += sprintf(big + bl, "#EXTINF:100,Last\r\nshort.mp3\r\n");
+    put("0:/MUSIC/Big.m3u", big, bl);
+    f_mount(NULL, "0:", 0);
+}
+
+// ------------------------------------------------------------------ tests
+int main(int argc, char **argv)
+{
+    const char *files = argc > 1 ? argv[1] : "USB_FILES";
+    build_image(files);
+
+    static uint8_t arena[128 * 1024];
+    seone_init(arena, sizeof arena);
+    seone_core1_init();
+
+    if (argc > 2 && !strcmp(argv[2], "--ref"))
+    {
+        // decode /MUSIC/short.mp3 at 0 dB, flat tone, for comparison with a reference decoder
+        host_wav_open("ref_out.wav");
+        atsend("AT+SEMODE=MP3B");
+        atsend("AT+DSPVOLL=100"); atsend("AT+DSPVOLR=100");
+        atsend("AT+MSDPATH=0:/MUSIC");
+        atsend("AT+MSDPLAY=short.mp3");
+        run_until_end(400000);
+        host_wav_close();
+        return 0;
+    }
+    host_wav_open("out.wav");
+
+    printf("[TNC probe at start-up]\n");
+    {
+        CHECK(inp(0x41) == 0xFF, "TNC port must float before it is used");
+        outp(0x41, 0); outp(0x42, 0x1A); outp(0x42, 0); outp(0x41, 0x48);
+        int w = 0; while (inp(0x41) == 1 && w < 100000) w++;
+        CHECK(w < 100000, "status never left busy");
+        char id[300]; int n = 0, d;
+        while ((d = inp(0x42)) > 0 && n < 299) id[n++] = (char)d;
+        id[n] = 0;
+        CHECK(n == 0, "ID string should be empty, got %d bytes", n);
+        outp(0x40, 0x08);
+        CHECK(inp(0x41) == 0xFF, "must stay off the bus while switched-I/O ID 8 is selected");
+        outp(0x40, 'A');
+    }
+
+    printf("[start-up AT traffic]\n");
+    CHECK(atsend("AT+SEMODE=MP3A") == 1 && strcmp(RESP, "OK") == 0, "SEMODE=MP3A -> %s", RESP);
+    CHECK(atsend("AT+MSDSTOP") == 1 && strcmp(RESP, "OK") == 0, "MSDSTOP -> %s", RESP);
+    atsend("AT+SEMODE?");
+    CHECK(strcmp(RESP, "AT+SEMODE=MP3A") == 0 && strcmp(RVAL, "MP3A") == 0, "SEMODE? -> %s / %s", RESP, RVAL);
+    atsend("AT+DSPVOLL=50");
+    atsend("AT+DSPVOLL?");
+    CHECK(strcmp(RVAL, "50") == 0, "DSPVOLL? -> %s", RVAL);
+    atsend("AT+DSPBASS=70");
+    atsend("AT+DSPTREBLE?");
+    CHECK(strcmp(RVAL, "50") == 0, "DSPTREBLE? -> %s", RVAL);
+    atsend("AT+BOGUS");
+    CHECK(strcmp(RESP, "ERR") == 0, "unknown command -> %s", RESP);
+    atsend("AT+SEFAULTNR?");
+    CHECK(strcmp(RVAL, "20") == 0, "fault after unknown -> %s", RVAL);
+    atsend("at+semode?");
+    CHECK(strcmp(RVAL, "MP3A") == 0, "lower case command -> %s", RESP);
+    atsend("AT+FMFREQ?");
+    CHECK(strcmp(RVAL, "87.5") == 0, "FMFREQ? -> %s", RVAL);
+
+    printf("[MP3 USB page: mode, init, root listing]\n");
+    CHECK(atsend("AT+SEMODE=MP3B") == 1 && !strcmp(RESP, "OK"), "MP3B");
+    CHECK(atsend("AT+USBINIT") == 1 && !strcmp(RESP, "OK"), "USBINIT -> %s", RESP);
+    CHECK(atsend("AT+MSDPATH=1:/") == 1 && !strcmp(RESP, "OK"), "MSDPATH=1:/ -> %s", RESP);
+    list_dir(0);
+    list_print();
+    CHECK(list_has("/MUSIC") && list_has("/SAMPLE") && list_has("/SETALK"), "root dirs");
+    CHECK(list_has("ROOT.MP3"), "root file");
+    CHECK(!list_has("/System Volume Information"), "hidden/system dir must be skipped");
+
+    printf("[enter /MUSIC]\n");
+    char path[256] = "1:";
+    strcat(path, "/MUSIC");
+    CHECK(atsend("AT+MSDPATH=%s", path) == 1 && !strcmp(RESP, "OK"), "MSDPATH %s -> %s", path, RESP);
+    list_dir(0);
+    list_print();
+    CHECK(list_has("/Sandra Collection"), "LFN directory with a space");
+    CHECK(list_has("short.MP3") && list_has("test.WAV"), "files with upper-case extension");
+    CHECK(!list_has("readme.TXT") && !list_has("._short.MP3"), "non-audio / dot files filtered");
+
+    printf("[enter '/Sandra Collection' (space stripped by SE Play)]\n");
+    strcat(path, "/Sandra Collection");
+    CHECK(atsend("AT+MSDPATH=%s", path) == 1 && !strcmp(RESP, "OK"), "MSDPATH %s -> %s", path, RESP);
+    list_dir(0);
+    list_print();
+    CHECK(list_has("/bonus"), "subdir");
+    CHECK(list_has("01SAND~1.MP3"), "long name falls back to 8.3");
+    list_dir(1);
+    list_print();
+    CHECK(LIST_N == 2 && !strcmp(LIST[0], "/bonus") && !strcmp(LIST[1], "Sandra.M3U"), "M3U page: folders + playlists only");
+
+    printf("[play a file picked from the list]\n");
+    list_dir(0);
+    CHECK(atsend("AT+MSDPLAY=%s", "01SAND~1.MP3") == 1 && !strcmp(RESP, "OK"), "MSDPLAY -> %s", RESP);
+    CHECK(!(status() & SEONE_ST_END_OF_MUSIC), "bit3 must clear as soon as OK is seen");
+    atsend("AT+MSDPLAY?");
+    CHECK(!strcmp(RVAL, "BUSY"), "MSDPLAY? -> %s", RVAL);
+    atsend("AT+MSDSIZE?");
+    CHECK(atoi(RVAL) > 1000, "MSDSIZE -> %s", RVAL);
+    uint32_t f0 = host_audio_frames;
+    for (int i = 0; i < 60; i++) { core1_tick(); }
+    uint8_t vl = inp(0x26), vr = inp(0x27);
+    printf("    VU after 60 frames: %u %u, rate %u\n", vl, vr, host_audio_last_rate);
+    CHECK(host_audio_frames > f0 + 30000, "audio frames produced (%u)", host_audio_frames - f0);
+    CHECK(vl <= 8 && vr <= 8, "VU range");
+    atsend("AT+MSDPAUSE");
+    uint32_t f1 = host_audio_frames;
+    for (int i = 0; i < 20; i++) core1_tick();
+    CHECK(host_audio_frames == f1, "paused: no output");
+    CHECK(!(status() & SEONE_ST_END_OF_MUSIC), "paused still counts as playing");
+    atsend("AT+MSDSTART");
+    uint32_t t = run_until_end(200000);
+    uint32_t total = host_audio_frames - f0;
+    printf("    track finished after %u ticks, %u frames (%.1f s)\n", t, total, total / 44100.0);
+    CHECK(status() & SEONE_ST_END_OF_MUSIC, "bit3 set at end of track");
+    atsend("AT+MSDPLAY?");
+    CHECK(!strcmp(RVAL, "IDLE"), "MSDPLAY? after end -> %s", RVAL);
+
+    printf("[play LFN typed without spaces / with a different case]\n");
+    CHECK(atsend("AT+MSDPLAY=02 Sandra - In The Heat Of The Night.mp3") == 1 && !strcmp(RESP, "OK"), "stripped LFN -> %s", RESP);
+    atsend("AT+MSDSTOP");
+    CHECK(status() & SEONE_ST_END_OF_MUSIC, "stopped");
+    CHECK(atsend("AT+MSDPLAY=nothere.mp3") == 1 && !strcmp(RESP, "ERR"), "missing file -> %s", RESP);
+
+    printf("[M3U playlist]\n");
+    {
+        char m3u_path[300];
+        snprintf(m3u_path, sizeof m3u_path, "%s/%s", path, "Sandra.M3U");
+        CHECK(atsend("AT+MSDM3UFILE=%s", m3u_path) == 1 && !strcmp(RESP, "OK"), "M3UFILE -> %s", RESP);
+        int played = 0;
+        for (int row = 1; row < 20; row++)
+        {
+            atsend("AT+MSDM3UGETROW=%d", row);
+            if (!strncmp(RESP, "#END#", 5)) { printf("    row %d: #END#\n", row); break; }
+            printf("    row %d: %s\n", row, RESP);
+            if (RESP[0] == '#') continue;
+            char name[80];
+            derive(RESP, name);
+            int ok = atsend("AT+MSDPLAY=%s", name) == 1 && !strcmp(RESP, "OK");
+            CHECK(ok, "playlist entry '%s' -> %s", name, RESP);
+            if (ok) played++;
+            atsend("AT+MSDSTOP");
+        }
+        CHECK(played == 4, "all 4 playlist entries playable (%d)", played);
+        atsend("AT+MSDM3UGETROW=99");
+        CHECK(!strcmp(RESP, "#END#"), "past end -> %s", RESP);
+    }
+
+    printf("[1000-entry playlist stays linear]\n");
+    {
+        atsend("AT+MSDPATH=0:/MUSIC");
+        CHECK(atsend("AT+MSDM3UFILE=0:/MUSIC/Big.M3U") == 1 && !strcmp(RESP, "OK"), "big M3U -> %s", RESP);
+        uint32_t r0 = host_disk_reads;
+        atsend("AT+MSDM3UGETROW=2001");
+        CHECK(!strcmp(RESP, "short.mp3"), "last row -> %s", RESP);
+        uint32_t r1 = host_disk_reads;
+        CHECK(atsend("AT+MSDPLAY=nosuchfile.mp3") == 1 && !strcmp(RESP, "ERR"), "unknown name scans whole list -> %s", RESP);
+        uint32_t r2 = host_disk_reads;
+        printf("    sector reads: GETROW %u, failed lookup %u\n", r1 - r0, r2 - r1);
+        CHECK(r2 - r1 < 400, "lookup must be one pass over the playlist (%u reads)", r2 - r1);
+        atsend("AT+MSDSTOP");
+        atsend("AT+MSDM3UFILE=0:/MUSIC/SandraCollection/Sandra.M3U");
+    }
+
+    printf("[path navigation edge cases]\n");
+    CHECK(atsend("AT+MSDPATH=0:") == 1 && !strcmp(RESP, "OK"), "root as '0:' -> %s", RESP);
+    CHECK(atsend("AT+MSDPATH=0:/NOPE") == 1 && !strcmp(RESP, "ERR"), "missing dir -> %s", RESP);
+    CHECK(atsend("AT+MSDPATH=0:/ROOT.MP3") == 1 && !strcmp(RESP, "ERR"), "file as dir -> %s", RESP);
+    atsend("AT+MSDPATH=0:/music");
+    CHECK(!strcmp(RESP, "OK"), "case-insensitive dir -> %s", RESP);
+    atsend("AT+MSDPATH?");
+    CHECK(!strcmp(RVAL, "0:/music"), "MSDPATH? -> %s", RVAL);
+
+    printf("[WAV file]\n");
+    CHECK(atsend("AT+MSDPLAY=test.WAV") == 1 && !strcmp(RESP, "OK"), "WAV -> %s", RESP);
+    f0 = host_audio_frames;
+    run_until_end(200000);
+    printf("    wav frames %u @ %u Hz\n", host_audio_frames - f0, host_audio_last_rate);
+    CHECK(host_audio_frames > f0, "WAV produced audio");
+
+    printf("[speech + samples]\n");
+    CHECK(atsend("AT+MSDTALK=44") == 1 && !strcmp(RESP, "OK"), "MSDTALK -> %s", RESP);
+    CHECK(status() & SEONE_ST_USB_BUSY, "bit5 busy while speaking");
+    CHECK(status() & SEONE_ST_END_OF_MUSIC, "speech is not music");
+    { int w = 0; while ((status() & SEONE_ST_USB_BUSY) && w++ < 100000) core1_tick(); CHECK(w < 100000, "speech ends"); }
+    CHECK(atsend("AT+MSDSETSAMPLE=1@BELL.MP3") == 1 && !strcmp(RESP, "OK"), "SETSAMPLE -> %s", RESP);
+    CHECK(atsend("AT+MSDSAMPLE=1") == 1 && !strcmp(RESP, "OK"), "SAMPLE -> %s", RESP);
+    { int w = 0; while ((status() & SEONE_ST_USB_BUSY) && w++ < 100000) core1_tick(); }
+
+    printf("[webradio stream through port 0x22]\n");
+    {
+        size_t len; char p[512];
+        snprintf(p, sizeof p, "%s/AUDIO/test.mp3", files);
+        uint8_t *mp3 = slurp(p, &len);
+        f0 = host_audio_frames;
+        size_t pos = 0; int stalls = 0;
+        while (pos < len && stalls < 1000000)
+        {
+            // SE Play 0x1D40: only push while INP(&H21) < &H75
+            if (inp(0x21) < 0x75)
+            {
+                size_t chunk = len - pos < 512 ? len - pos : 512;
+                for (size_t i = 0; i < chunk; i++) outp(0x22, mp3[pos + i]);
+                pos += chunk;
+            }
+            else { core1_tick(); stalls++; }
+        }
+        for (int i = 0; i < 400; i++) core1_tick();
+        printf("    streamed %zu bytes -> %u frames\n", len, host_audio_frames - f0);
+        CHECK(host_audio_frames - f0 > 40000, "stream decoded");
+        host_advance_ms(5000); core1_tick(); core1_tick();
+        CHECK(status() & SEONE_ST_END_OF_MUSIC, "stream ends after data stops");
+        free(mp3);
+    }
+
+    printf("[I2S queue full: commands still answered]\n");
+    atsend("AT+MSDPATH=0:/");
+    atsend("AT+MSDPLAY=ROOT.MP3");
+    host_audio_queue_full = true;
+    CHECK(atsend("AT+DSPVOLR=40") == 1 && !strcmp(RESP, "OK"), "busy audio does not block AT");
+    host_audio_queue_full = false;
+    atsend("AT+MSDSTOP");
+
+    printf("[REG mode]\n");
+    atsend("AT+SEMODE=REG");
+    outp(0x26, 0x60);
+    { int w = 0; while (inp(0x26) == SEONE_REG_BUSY && w++ < 100000) {} }
+    char fw[16]; int n = 0, d;
+    while ((d = inp(0x27)) != 0 && n < 15) fw[n++] = (char)d;
+    fw[n] = 0;
+    CHECK(!strcmp(fw, "20250306"), "REG 0x60 firmware -> %s", fw);
+    outp(0x26, 0); outp(0x27, 45); outp(0x27, 55); outp(0x26, 50);
+    { int w = 0; while (inp(0x26) == SEONE_REG_BUSY && w++ < 100000) {} }
+    CHECK(inp(0x26) == SEONE_REG_IDLE, "REG 50 ok");
+    outp(0x26, 51);
+    { int w = 0; while (inp(0x26) == SEONE_REG_BUSY && w++ < 100000) {} }
+    int a = inp(0x27), b = inp(0x27);
+    CHECK(a == 45 && b == 55, "REG 51 volume -> %d %d", a, b);
+    outp(0x26, 0xEE);
+    { int w = 0; while (inp(0x26) == SEONE_REG_BUSY && w++ < 100000) {} }
+    CHECK(inp(0x26) == SEONE_REG_ERROR, "unknown REG function -> error");
+    atsend("AT+SEMODE=MP3B");
+
+    printf("[AT+LIST / help]\n");
+    atsend("AT+LIST");
+    CHECK(!strcmp(RESP, "AT+LIST="), "LIST first line -> %s", RESP);
+    atsend("AT+MSDPLAY/H");
+    CHECK(!strncmp(RESP, "AT+MSDPLAY/H=", 13), "help -> %s", RESP);
+
+    host_wav_close();
+    printf("\n%d checks, %d failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
diff --git a/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_netd.c b/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_netd.c
new file mode 100644
index 0000000..6d93bee
--- /dev/null
+++ b/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_netd.c
@@ -0,0 +1,358 @@
+// End-to-end test of the network-daemon patched SE Play (SEPLAY_NETD.EXE).
+//
+// Runs SE Play's Z80 code (loaded and relocated like the SymbOS loader) with:
+//   * a minimal SymbOS message kernel: rst #10 send, rst #18 / #08 receive,
+//     rst #30 idle,
+//   * a system manager answering MSC_SYS_PRGSRV (shared service search),
+//   * a fake SymbOS Network Daemon ("Network Daem", process 9) that accepts
+//     TCP connections and serves an MP3 file as an endless "web radio",
+//   * the PicoVerse SE-ONE emulation on ports 20h-27h (MP3 decoding).
+// It checks that SE Play never touches the TNC ports 40h-49h.
+//
+// usage: z80_netd SEPLAY_NETD.EXE test.img stream.mp3
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "z80.h"
+#include "ff.h"
+#include "seone.h"
+#include "seone_internal.h"
+
+int  host_disk_open(const char *path, uint32_t create_sectors);
+void host_advance_ms(uint32_t ms);
+extern uint32_t host_audio_frames;
+
+static uint8_t mem[65536];
+static z80 cpu;
+static uint16_t g_shift;          // bytes the patch added to the code segment
+#define D(x) ((uint16_t)((x) >= 0x73E2 ? (x) + g_shift : (x)))
+static unsigned long tnc_io, io_count;
+static const uint8_t APP_PID = 7, NET_PID = 9, SYS_PID = 3;
+static int daemon_running = 1;
+
+static uint16_t w16(uint16_t a) { return mem[a] | (mem[a + 1] << 8); }
+static void s16(uint16_t a, uint16_t v) { mem[a] = v & 0xFF; mem[a + 1] = v >> 8; }
+static uint8_t rd(void *u, uint16_t a) { (void)u; return mem[a]; }
+static void wr(void *u, uint16_t a, uint8_t v) { (void)u; mem[a] = v; }
+static void tick(void) { seone_core1_poll(); host_advance_ms(1); }
+
+static uint8_t pin(z80 *z, uint8_t port)
+{
+    (void)z;
+    if (++io_count % 5 == 0) tick();
+    if (port >= 0x40 && port <= 0x49) tnc_io++;
+    uint8_t v = 0xFF;
+    if (port >= 0x20 && port <= 0x27 && !seone_io_read(port, &v)) v = 0xFF;
+    return v;
+}
+static void pout(z80 *z, uint8_t port, uint8_t v)
+{
+    (void)z;
+    if (port >= 0x40 && port <= 0x49) tnc_io++;
+    if (port >= 0x20 && port <= 0x27) seone_io_write(port, v);
+}
+
+// ------------------------------------------------------------ message kernel
+typedef struct { uint8_t from, to, d[14]; } msg_t;
+static msg_t q[64];
+static int qn;
+static void post(uint8_t from, uint8_t to, const uint8_t *d)
+{
+    if (qn < 64) { q[qn].from = from; q[qn].to = to; memcpy(q[qn].d, d, 14); qn++; }
+}
+
+// fake daemon state
+static uint8_t *stream; static size_t stream_len, stream_pos;
+static int sock_open, events_sent;
+static char http_req[1024]; static size_t http_len;
+static unsigned long net_calls[256];
+
+static void reply(uint8_t to, uint8_t fn, uint8_t a, int cf, int zf, uint16_t bc, uint16_t de, uint16_t hl, uint16_t ix, uint16_t iy)
+{
+    uint8_t m[14] = {0};
+    m[0] = fn;
+    m[2] = (cf ? 1 : 0) | (zf ? 0x40 : 0);
+    m[3] = a;
+    m[4] = bc; m[5] = bc >> 8; m[6] = de; m[7] = de >> 8;
+    m[8] = hl; m[9] = hl >> 8; m[10] = ix; m[11] = ix >> 8; m[12] = iy; m[13] = iy >> 8;
+    post(NET_PID, to, m);
+}
+
+static void daemon_handle(uint8_t from, const uint8_t *m)
+{
+    uint8_t fn = m[0], a = m[3];
+    uint16_t bc = m[4] | (m[5] << 8), de = m[6] | (m[7] << 8), hl = m[8] | (m[9] << 8);
+    uint16_t ix = m[10] | (m[11] << 8), iy = m[12] | (m[13] << 8);
+    net_calls[fn]++;
+    if (++events_sent % 3 == 0)
+    {   // unsolicited TCP event in between, must be skipped by SE Play
+        uint8_t ev[14] = { 159, 0 };
+        post(NET_PID, from, ev);
+    }
+    size_t avail = stream_len - stream_pos;
+    switch (fn)
+    {
+        case 16:  // TCPOPN
+            printf("    daemon: TCPOPN mode %u to %u.%u.%u.%u:%u local %04X\n", a, ix & 0xFF, ix >> 8, iy & 0xFF, iy >> 8, de, hl);
+            sock_open = 1; stream_pos = 0;
+            reply(from, fn + 128, 0, 0, 0, 0, 0, 0, 0, 0);
+            break;
+        case 18:  // TCPSTA
+            if (!sock_open) { reply(from, fn + 128, 9, 1, 0, 0, 0, 0, 0, 0); break; }
+            reply(from, fn + 128, a, 0, 0, avail > 2920 ? 2920 : (uint16_t)avail, 8000, (avail ? 128 : 0) | 2, 0, 0);
+            break;
+        case 19:  // TCPRCV
+        {
+            size_t n = bc;
+            if (n > avail) n = avail;
+            if (n > 2920) n = 2920;
+            memcpy(&mem[hl], stream + stream_pos, n);
+            stream_pos += n;
+            if (stream_pos >= stream_len) stream_pos = 0;          // endless radio
+            reply(from, fn + 128, a, 0, 0, (uint16_t)n, 0, 0, 0, 0);
+            break;
+        }
+        case 20:  // TCPSND
+            if (http_len + bc < sizeof http_req) { memcpy(http_req + http_len, &mem[hl], bc); http_len += bc; }
+            reply(from, fn + 128, a, 0, 1, bc, 0, 0, 0, 0);
+            break;
+        case 17:  // TCPCLO
+            sock_open = 0;
+            reply(from, fn + 128, a, 0, 0, 0, 0, 0, 0, 0);
+            break;
+        default:
+            reply(from, fn + 128, 3, 1, 0, 0, 0, 0, 0, 0);
+    }
+}
+
+static void system_handle(uint8_t from, const uint8_t *m)
+{
+    if (m[0] != 30) return;                        // MSC_SYS_PRGSRV
+    uint16_t name = m[1] | (m[2] << 8);
+    uint8_t r[14] = { 158, 5 };
+    if (daemon_running && memcmp(&mem[name], "Network Daem", 12) == 0)
+    {
+        r[1] = 0; r[8] = 5; r[9] = NET_PID;
+    }
+    post(SYS_PID, from, r);
+}
+
+static void ret_from_rst(void) { cpu.pc = w16(cpu.sp); cpu.sp += 2; }
+
+// returns true if PC was a kernel entry that has been emulated
+static bool kernel(void)
+{
+    uint8_t ixl = cpu.ix & 0xFF, ixh = cpu.ix >> 8;
+    switch (cpu.pc)
+    {
+        case 0x10:      // send: IXL=sender IXH=receiver IY=message
+        {
+            uint8_t m[14];
+            memcpy(m, &mem[cpu.iy], 14);
+            if (ixh == NET_PID) daemon_handle(ixl, m);
+            else if (ixh == SYS_PID) system_handle(ixl, m);
+            else post(ixl, ixh, m);
+            ret_from_rst();
+            return true;
+        }
+        case 0x08: case 0x18:   // receive: IXL=receiver IXH=sender filter (-1 any)
+        {
+            for (int i = 0; i < qn; i++)
+                if (q[i].to == ixl && (ixh == 0xFF || q[i].from == ixh))
+                {
+                    memcpy(&mem[cpu.iy], q[i].d, 14);
+                    cpu.ix = (uint16_t)(q[i].from << 8) | 1;
+                    memmove(&q[i], &q[i + 1], (qn - i - 1) * sizeof q[0]);
+                    qn--;
+                    ret_from_rst();
+                    return true;
+                }
+            cpu.ix = (cpu.ix & 0xFF00);      // IXL=0: nothing
+            ret_from_rst();
+            return true;
+        }
+        case 0x30:      // idle
+            tick();
+            ret_from_rst();
+            return true;
+        case 0x20: case 0x28: case 0x38: case 0x00:
+            ret_from_rst();
+            return true;
+    }
+    return false;
+}
+
+#define SENTINEL 0xFFF0
+static bool call(uint16_t addr, unsigned long max_steps)
+{
+    cpu.sp -= 2;
+    s16(cpu.sp, SENTINEL);
+    cpu.pc = addr;
+    for (unsigned long i = 0; i < max_steps; i++)
+    {
+        if (cpu.pc == SENTINEL) return true;
+        if (cpu.pc < 0x40 && kernel()) continue;
+        z80_step(&cpu);
+    }
+    printf("    runaway at PC=%04X\n", cpu.pc);
+    return false;
+}
+
+static const char *str(uint16_t var)
+{
+    static char buf[8][300]; static int k;
+    char *o = buf[k++ & 7];
+    uint16_t p = w16(D(var));
+    int n = 0;
+    while (mem[p + n] && n < 299) { o[n] = (char)mem[p + n]; n++; }
+    o[n] = 0;
+    return o;
+}
+
+static uint16_t const_area = 0xF100;
+static void assign(uint16_t var, const char *s)
+{
+    size_t l = strlen(s);
+    mem[const_area] = (uint8_t)(l + 1); mem[const_area + 1] = 0;
+    memcpy(&mem[const_area + 2], s, l + 1);
+    uint16_t p = const_area + 2;
+    const_area += (uint16_t)(l + 4);
+    cpu.h = p >> 8; cpu.l = p & 0xFF;
+    uint16_t dst = w16(D(var));
+    cpu.d = dst >> 8; cpu.e = dst & 0xFF;
+    call(0x5ED7, 100000);
+}
+
+static int fails;
+#define EXPECT(c, ...) do { if (!(c)) { fails++; printf("  FAIL: "); } else printf("  ok: "); printf(__VA_ARGS__); printf("\n"); } while (0)
+
+static void load(const char *exe)
+{
+    memset(mem, 0, sizeof mem);
+    FILE *f = fopen(exe, "rb");
+    size_t n = fread(&mem[0x100], 1, 65536 - 0x100, f);
+    fclose(f);
+    for (int i = 0; i < 0x40; i++) mem[i] = 0xC9;
+    uint16_t code = w16(0x100), data = w16(0x102), trans = w16(0x104), extra = w16(0x13A);
+    g_shift = code - 0x72E2;
+    uint16_t tr0 = 0x100 + code + data;
+    uint32_t reltab = 0x100u + code + data + trans;
+    static uint16_t rel[16384];
+    unsigned nrel = 0;
+    for (uint32_t r = reltab; r + 1 < 0x100u + n && nrel < 16384; r += 2) rel[nrel++] = w16((uint16_t)r);
+    memmove(&mem[tr0 + extra], &mem[tr0], trans);
+    memset(&mem[tr0], 0, extra);
+    memset(&mem[tr0 + extra + trans], 0, 0xF000u - (tr0 + extra + trans));
+    for (unsigned i = 0; i < nrel; i++)
+    {
+        uint16_t at = rel[i];
+        if (at >= tr0) at += extra;
+        uint16_t v = w16(at);
+        if (v >= tr0) s16(at, v + extra);
+    }
+    s16(0x102, data + extra);
+    mem[0x10E] = 1;                              // ram bank
+    mem[D(0x7E6E)] = APP_PID;                    // own process ID
+    for (int i = 0; i < 0x40; i++) mem[i] = 0xC9;
+    // GUI output needs the SymbOS desktop
+    mem[0x1234] = 0xC9; mem[0x113A] = 0xC9; mem[0x11B3] = 0xC9;
+    z80_init(&cpu);
+    cpu.read_byte = rd; cpu.write_byte = wr; cpu.port_in = pin; cpu.port_out = pout;
+    cpu.sp = 0x89BB + g_shift + extra;
+    printf("loaded %s: code +%u bytes, %u relocations\n", exe, g_shift, nrel);
+}
+
+int main(int argc, char **argv)
+{
+    FILE *f = fopen(argv[3], "rb");
+    fseek(f, 0, SEEK_END); stream_len = (size_t)ftell(f); fseek(f, 0, SEEK_SET);
+    stream = malloc(stream_len); fread(stream, 1, stream_len, f); fclose(f);
+
+    host_disk_open(argv[2], 0);
+    static uint8_t arena[128 * 1024];
+    seone_init(arena, sizeof arena);
+    seone_core1_init();
+
+    load(argv[1]);
+    printf("[start-up: program path written by the SymbOS loader after the code]\n");
+    {   // SE Play builds its data file names from this path (5FEBh)
+        uint16_t end = (uint16_t)(0x100 + w16(0x100));
+        uint8_t save[64]; memcpy(save, &mem[end], sizeof save);
+        const char *path = "C:\\APPS\\SEPLAY\\SEPLAYN.EXE";
+        memcpy(&mem[end], path, strlen(path) + 1);
+        bool ok = call(0x5FEB, 100000);
+        char dir[64]; uint16_t hl = (uint16_t)(cpu.h << 8 | cpu.l);
+        snprintf(dir, sizeof dir, "%s", (char *)&mem[hl]);
+        memcpy(&mem[end], save, sizeof save);
+        EXPECT(ok && !strcmp(dir, "C:\\APPS\\SEPLAY\\"), "application folder '%s'", dir);
+    }
+    printf("[start-up: platform init + network card probe]\n");
+    EXPECT(call(0x4C1E, 2000000), "platform init");
+    s16(D(0x7599), 0);
+    EXPECT(call(0x4FEC, 2000000), "probe returns, HWID$='%s'", str(0x75BB));
+    EXPECT(net_calls[16] == 0 && qn == 0, "probe only asked the system manager");
+    {   // AT+SEMODE=MP3A as at 0C21..0C2E
+        cpu.pc = 0x0C21;
+        for (long i = 0; i < 3000000 && cpu.pc != 0x0C2E; i++) { if (cpu.pc < 0x40 && kernel()) continue; z80_step(&cpu); }
+        EXPECT(!strcmp(str(0x77A6), "OK"), "AT+SEMODE=MP3A -> '%s'", str(0x77A6));
+    }
+
+    printf("[MP3 page still works with the relinked data segment]\n");
+    EXPECT(call(0x1DED, 20000000), "MP3 page init, PATH$='%s'", str(0x77AA));
+    printf("    list:");
+    for (int i = 0; i < 6; i++) printf(" [%s]", str((uint16_t)(0x77B0 + 2 * i)));
+    printf("\n");
+    EXPECT(!strcmp(str(0x77B0), "/MUSIC"), "first entry /MUSIC");
+
+    printf("[web radio: station from WEBRADIO.WRC, connect through the daemon]\n");
+    assign(0x7776, "089.147.108.034\t|8000\t|/radio.mp3\t\t\t\t\t\t|PIGPEN\t\t|www.pigpenradio.org\t|Reggae\t\t|dub\t\t|UK|");
+    s16(D(0x779E), 1);
+    EXPECT(call(0x1ACD, 5000000), "station parsed: %u.%u.%u.%u:%u stream '%s' name '%s'",
+           w16(D(0x7740)), w16(D(0x7742)), w16(D(0x7744)), w16(D(0x7746)), w16(D(0x774A)) * 256 + w16(D(0x774C)), str(0x774E), str(0x7750));
+    assign(0x75EF, "WEBRADIO");
+    EXPECT(call(0x1724, 5000000), "web radio page: AT+SEMODE=MP3B");
+    EXPECT(call(0x1885, 20000000), "connect routine returned, display '%s'", str(0x76BB));
+    EXPECT(w16(D(0x77A2)) == 1, "stream mode 1 (MSX pushes data), got %u", w16(D(0x77A2)));
+    http_req[http_len] = 0;
+    printf("    HTTP request sent:\n----\n%s----\n", http_req);
+    EXPECT(!strncmp(http_req, "GET /radio.mp3 HTTP/1.1\r\nHost: 89.147.108.34:8000\r\n", 51), "request line + Host header");
+    EXPECT(strstr(http_req, "\r\n\r\n") != NULL, "request terminated by an empty line");
+
+    printf("[stream tick 1D40 pumps daemon data into the SE-ONE]\n");
+    uint32_t f0 = host_audio_frames;
+    size_t s0 = stream_pos;
+    for (int t = 0; t < 1500; t++)
+    {
+        call(0x1D40, 5000000);
+        for (int k = 0; k < 3; k++) tick();
+    }
+    printf("    %u bytes received, %u frames decoded, daemon calls: TCPSTA %lu TCPRCV %lu\n",
+           (unsigned)(stream_pos - s0), host_audio_frames - f0, net_calls[18], net_calls[19]);
+    EXPECT(host_audio_frames - f0 > 100000, "web radio audio is playing");
+    EXPECT(!(seone.status & SEONE_ST_END_OF_MUSIC), "SE-ONE reports a stream playing");
+
+    printf("[stop web radio]\n");
+    EXPECT(call(0x1927, 5000000) && !sock_open && w16(D(0x77A2)) == 0, "socket closed, stream mode 0");
+
+    printf("[phone page]\n");
+    assign(0x75EF, "WEBRADIO");
+    EXPECT(call(0x2A45, 2000000) && !strcmp(str(0x76BB), "PHONE: NO TNC") && strcmp(str(0x75EF), "VOIP"),
+           "phone shows '%s', mode stays '%s'", str(0x76BB), str(0x75EF));
+
+    printf("[no daemon running]\n");
+    daemon_running = 0;
+    unsigned long opens = net_calls[16];
+    EXPECT(call(0x4FEC, 2000000), "probe returns without daemon");
+    EXPECT(call(0x1885, 20000000), "connect returns, display '%s'", str(0x76BB));
+    EXPECT(net_calls[16] == opens && w16(D(0x77A2)) == 0, "no TCP open attempted, not streaming");
+
+    printf("[daemon started later]\n");
+    daemon_running = 1;
+    EXPECT(call(0x1885, 20000000) && w16(D(0x77A2)) == 1 && sock_open, "connects once the daemon is there");
+    call(0x1927, 5000000);
+
+    EXPECT(tnc_io == 0, "no access to TNC ports 40h-49h (%lu)", tnc_io);
+    printf("\n%d failures\n", fails);
+    return fails != 0;
+}
diff --git a/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_seplay.c b/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_seplay.c
new file mode 100644
index 0000000..33de8e6
--- /dev/null
+++ b/2350/software/loadrom.pio/pico/loadrom/seone/tests/z80_seplay.c
@@ -0,0 +1,271 @@
+// Runs SE Play's own Z80 routines (SEPLAY.EXE loaded at its link address
+// 0x0100, relocated like the SymbOS loader does) against the SE-ONE
+// emulation. SymbOS kernel calls (RST vectors) and GUI text output are
+// stubbed with RET.
+//
+// Needs SEPLAY.EXE (SE Play 0.1, not included) and the single-file Z80 core
+// from https://github.com/superzazu/z80; see the Makefile target "z80".
+// usage: z80_seplay SEPLAY.EXE test.img   (test.img is written by host_seplay)
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "z80.h"
+#include "ff.h"
+#include "seone.h"
+#include "seone_internal.h"
+
+int  host_disk_open(const char *path, uint32_t create_sectors);
+void host_advance_ms(uint32_t ms);
+extern uint32_t host_audio_frames;
+
+static uint8_t mem[65536];
+static z80 cpu;
+static unsigned long io_count, rst_count[8];
+static int trace_io;
+
+static uint16_t w16(uint16_t a) { return mem[a] | (mem[a + 1] << 8); }
+static uint8_t rd(void *u, uint16_t a) { (void)u; return mem[a]; }
+static void wr(void *u, uint16_t a, uint8_t v) { (void)u; mem[a] = v; }
+
+static void tick(void) { seone_core1_poll(); host_advance_ms(1); }
+
+static uint8_t pin(z80 *z, uint8_t port)
+{
+    (void)z;
+    if (++io_count % 5 == 0) tick();
+    uint8_t v = 0xFF;
+    if (seone_port_claimed(port) && !seone_io_read(port, &v)) v = 0xFF;
+    if (trace_io && port != 0x20) printf("      IN  %02X -> %02X\n", port, v);
+    return v;
+}
+
+static void pout(z80 *z, uint8_t port, uint8_t v)
+{
+    (void)z;
+    if (trace_io && port != 0x40) printf("      OUT %02X <- %02X '%c'\n", port, v, v >= 32 && v < 127 ? v : '.');
+    if (seone_port_claimed(port)) seone_io_write(port, v);
+}
+
+#define SENTINEL 0xFFF0
+// Call a routine and run until it returns. Returns false on runaway.
+static const char *str(uint16_t var);
+static uint16_t hist[4096]; static unsigned hpos;
+static uint16_t calls_hist[256]; static unsigned cpos;
+static void dump_hist(void)
+{
+    printf("    last calls:");
+    for (unsigned i = 0; i < 24; i++) printf(" %04X", calls_hist[(cpos - 24 + i) & 255]);
+    printf("\n    last PCs:");
+    uint16_t prev = 0;
+    for (unsigned i = 0; i < 1500; i++) { uint16_t pc = hist[(hpos - 1500 + i) & 4095]; if (pc < prev || pc > prev + 4) printf(" | %04X", pc); prev = pc; }
+    printf("\n");
+}
+static void step(void)
+{
+    hist[hpos++ & 4095] = cpu.pc;
+    uint8_t op = mem[cpu.pc];
+    if (op == 0xCD || (op & 0xC7) == 0xC4) calls_hist[cpos++ & 255] = cpu.pc;
+    z80_step(&cpu);
+}
+static bool call(uint16_t addr, unsigned long max_steps)
+{
+    cpu.sp -= 2;
+    mem[cpu.sp] = SENTINEL & 0xFF; mem[cpu.sp + 1] = SENTINEL >> 8;
+    cpu.pc = addr;
+    for (unsigned long i = 0; i < max_steps; i++)
+    {
+        if (cpu.pc == SENTINEL) return true;
+        if (cpu.pc < 0x40 && (cpu.pc & 7) == 0) rst_count[cpu.pc >> 3]++;
+        step();
+        if (cpu.pc == 0x5F4C) printf("    OUT OF STRING SPACE: heap ptr %04X limit %04X\n", w16(0x541), 0x73E2 + w16(0x102));
+        if (cpu.pc == 0x675A) printf("    GC: heap ptr %04X\n", w16(0x541));
+        if (cpu.pc >= 0x7400 && cpu.pc < 0xFF00) { printf("    jumped into data at %04X\n", cpu.pc); dump_hist(); return false; }
+    }
+    printf("    runaway at PC=%04X\n", cpu.pc);
+    dump_hist();
+    return false;
+}
+
+// Run from 'start' until PC reaches 'stop' (inside a routine).
+static bool run_between(uint16_t start, uint16_t stop, unsigned long max_steps)
+{
+    cpu.pc = start;
+    for (unsigned long i = 0; i < max_steps; i++)
+    {
+        if (cpu.pc == stop) return true;
+        if (cpu.pc < 0x40 && (cpu.pc & 7) == 0) rst_count[cpu.pc >> 3]++;
+        z80_step(&cpu);
+    }
+    printf("    runaway at PC=%04X\n", cpu.pc);
+    return false;
+}
+
+
+// String variable -> C string (data pointer stored in the variable)
+static const char *str(uint16_t var)
+{
+    static char buf[8][300];
+    static int k;
+    char *o = buf[k++ & 7];
+    uint16_t p = w16(var);
+    int n = 0;
+    while (mem[p + n] && n < 299) { o[n] = (char)mem[p + n]; n++; }
+    o[n] = 0;
+    return o;
+}
+
+// Put a constant string in free memory in SE Play's const format and
+// assign it to a string variable through the program's own STRASSIGN.
+static uint16_t const_area = 0xE000;
+static void assign(uint16_t var, const char *s)
+{
+    size_t l = strlen(s);
+    mem[const_area] = (uint8_t)(l + 1); mem[const_area + 1] = 0;
+    memcpy(&mem[const_area + 2], s, l + 1);
+    uint16_t p = const_area + 2;
+    const_area += (uint16_t)(l + 4);
+    cpu.h = p >> 8; cpu.l = p & 0xFF;
+    uint16_t dst = w16(var);
+    cpu.d = dst >> 8; cpu.e = dst & 0xFF;
+    call(0x5ED7, 100000);
+}
+
+static void set16(uint16_t a, uint16_t v) { mem[a] = v & 0xFF; mem[a + 1] = v >> 8; }
+
+static void print_list(void)
+{
+    printf("    SE Play list array (0x77B0):");
+    for (int i = 0; i < 50; i++)
+    {
+        const char *s = str((uint16_t)(0x77B0 + 2 * i));
+        printf(" [%s]", s);
+        if (!strcmp(s, "_END_")) break;
+    }
+    printf("\n");
+}
+
+static int fails;
+#define EXPECT(c, ...) do { if (!(c)) { fails++; printf("  FAIL: "); printf(__VA_ARGS__); printf("\n"); } else { printf("  ok: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+int main(int argc, char **argv)
+{
+    FILE *f = fopen(argv[1], "rb");
+    size_t n = fread(&mem[0x100], 1, 65536 - 0x100, f);
+    fclose(f);
+    printf("loaded %zu bytes\n", n);
+    for (int i = 0; i < 0x40; i++) mem[i] = 0xC9;    // RST vectors -> RET
+    mem[0x38] = 0xFB; mem[0x39] = 0xC9;               // EI;RET
+    // GUI text output (marquee/label refresh) needs the SymbOS desktop: stub it
+    mem[0x1234] = 0xC9; mem[0x113A] = 0xC9; mem[0x11B3] = 0xC9;
+
+    host_disk_open(argv[2], 0);                       // image made by host_seplay
+    static uint8_t arena[128 * 1024];
+    seone_init(arena, sizeof arena);
+    seone_core1_init();
+
+    z80_init(&cpu);
+    cpu.read_byte = rd; cpu.write_byte = wr; cpu.port_in = pin; cpu.port_out = pout;
+    // SymbOS loader emulation: the data segment is extended by the header's
+    // "extra data memory" (offset 0x3A) - that is where the Quigs string heap
+    // grows - and the transfer segment is placed after it. Shift the transfer
+    // segment and patch every relocated pointer into it.
+    {
+        uint16_t code = w16(0x100), data = w16(0x102), trans = w16(0x104);
+        uint16_t extra = w16(0x100 + 0x3A);
+        uint16_t tr0 = 0x100 + code + data;
+        uint32_t reltab = 0x100u + code + data + trans;
+        static uint16_t rel[16384];
+        unsigned nrel = 0;
+        for (uint32_t r = reltab; r + 1 < 0x100u + n && nrel < 16384; r += 2)
+            rel[nrel++] = w16((uint16_t)r);
+        memmove(&mem[tr0 + extra], &mem[tr0], trans);
+        memset(&mem[tr0], 0, extra);
+        memset(&mem[tr0 + extra + trans], 0, 0x10000u - (tr0 + extra + trans) - 0x100u);
+        unsigned patched = 0;
+        for (unsigned i = 0; i < nrel; i++)
+        {
+            uint16_t at = rel[i];
+            if (at >= tr0) at += extra;          // the word itself moved
+            uint16_t v = w16(at);
+            if (v >= tr0) { v += extra; mem[at] = v & 0xFF; mem[at + 1] = v >> 8; patched++; }
+        }
+        data += extra;
+        mem[0x102] = data & 0xFF; mem[0x103] = data >> 8;
+        printf("relocated %u pointers, string heap %04X..%04X, transfer at %04X\n", patched, w16(0x541), tr0 + extra, tr0 + extra);
+    }
+    cpu.sp = 0x89BB + w16(0x100 + 0x3A);   // relocated stack top
+
+    printf("[platform init 0x4C1E (sets network-card port variables)]\n");
+    bool ok0 = call(0x4C1E, 2000000);
+    EXPECT(ok0, "platform '%s', TNC ports %04X/%04X/%04X", str(0x7571), w16(0x7535), w16(0x7537), w16(0x753D));
+
+    printf("[TNC probe 0x4FEC (start-up)]\n");
+    set16(0x7599, 0);
+    bool ok = call(0x4FEC, 2000000);
+    EXPECT(ok, "TNC probe returns (hardware id '%s')", str(0x75BB));
+
+    printf("[ATSEND AT+SEMODE=MP3A as at 0x0C21]\n");
+    ok = run_between(0x0C21, 0x0C2E, 3000000);
+    EXPECT(ok && !strcmp(str(0x77A6), "OK"), "RESP$='%s'", str(0x77A6));
+
+    printf("[MP3 USB page init 0x1DED..: MP3B, USBINIT, TNC probe, MSDPATH, list]\n");
+    ok = call(0x1DED, 20000000);
+    EXPECT(ok, "page init returned, PATH$='%s'", str(0x77AA));
+    print_list();
+    EXPECT(!strcmp(str(0x77B0), "/MUSIC"), "first entry /MUSIC");
+
+    printf("[select /MUSIC and enter it via 0x2100]\n");
+    set16(0x781C, 0);                // not playing
+    assign(0x7818, "/MUSIC");
+    ok = call(0x2100, 20000000);
+    EXPECT(ok, "PATH$='%s', SEL$='%s'", str(0x77AA), str(0x7818));
+    print_list();
+
+    printf("[enter '/Sandra Collection']\n");
+    assign(0x7818, "/Sandra Collection");
+    ok = call(0x2100, 20000000);
+    EXPECT(ok && !strcmp(str(0x77AA), "1:/MUSIC/Sandra Collection"), "PATH$='%s'", str(0x77AA));
+    print_list();
+
+    printf("[play 01SAND~1.MP3 via 0x21A7]\n");
+    assign(0x7818, "01SAND~1.MP3");
+    ok = call(0x21A7, 5000000);
+    EXPECT(ok && w16(0x781C) == 1, "playing flag=%u RESP$='%s'", w16(0x781C), str(0x77A6));
+    for (int i = 0; i < 50; i++) tick();
+    EXPECT(host_audio_frames > 20000, "audio running (%u frames)", host_audio_frames);
+    EXPECT(!(seone.status & SEONE_ST_END_OF_MUSIC), "status bit 3 clear while playing");
+
+    printf("[status/VU poll as the timer tick does (0x14B2 VU, INP 0x23)]\n");
+    set16(0x76CA, 5);
+    ok = call(0x14B2, 2000000);
+    EXPECT(ok, "VU routine ran");
+
+    printf("[stop via 0x21F3]\n");
+    ok = call(0x21F3, 5000000);
+    EXPECT(ok && w16(0x781C) == 0 && (seone.status & SEONE_ST_END_OF_MUSIC), "stopped, flag=%u", w16(0x781C));
+
+    printf("[M3U: load playlist + first track via 0x24B3 path]\n");
+    assign(0x75EF, "M3U");
+    assign(0x7818, "Sandra.M3U");
+    set16(0x7822, 3);    // play mode 3 = repeat all (1 once, 2 random)
+    set16(0x781E, 0);
+    ok = run_between(0x24B3, 0x2518, 50000000);
+    EXPECT(ok, "M3U loaded, row=%u, title='%s', file='%s', RESP$='%s'", w16(0x781E), str(0x7828), str(0x7820), str(0x77A6));
+    for (int i = 0; i < 30; i++) tick();
+    EXPECT(!(seone.status & SEONE_ST_END_OF_MUSIC) && w16(0x7826) == 1, "M3U track playing (flag %u)", w16(0x7826));
+
+    printf("[next M3U track via 0x2568]\n");
+    ok = call(0x2568, 50000000);
+    EXPECT(ok, "row=%u file='%s' RESP$='%s'", w16(0x781E), str(0x7820), str(0x77A6));
+    for (int i = 0; i < 30; i++) tick();
+    EXPECT(!(seone.status & SEONE_ST_END_OF_MUSIC), "second track playing");
+    ok = call(0x2568, 50000000);
+    EXPECT(ok, "row=%u file='%s' RESP$='%s'", w16(0x781E), str(0x7820), str(0x77A6));
+    for (int i = 0; i < 30; i++) tick();
+    EXPECT(!(seone.status & SEONE_ST_END_OF_MUSIC), "third track (subfolder) playing");
+
+    printf("\nRST usage:");
+    for (int i = 0; i < 8; i++) printf(" %02X:%lu", i * 8, rst_count[i]);
+    printf("\n%d failures\n", fails);
+    return fails != 0;
+}
